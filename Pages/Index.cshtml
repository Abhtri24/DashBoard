@page
@model IndexModel
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
@{
    ViewData["Title"] = "Sales Overview";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h4 mb-1">Sales Overview</h2>
            <p class="text-secondary mb-0">Monitor performance and customize your dashboard.</p>
        </div>
        <button type="button" class="btn btn-primary" id="addDashboardCard">
            <span aria-hidden="true">+</span> Add Card
        </button>
    </div>

    <div id="overviewError" class="alert alert-danger d-none" role="alert"></div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" id="totalRevenueCard">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-secondary small" id="totalRevenueTitle">Total Revenue</div>
                            <div class="fs-3 fw-semibold mt-2 kpi-value" id="totalRevenue">Loading...</div>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm edit-chart"
                                data-card="totalRevenue" aria-expanded="false">Edit</button>
                    </div>
                    <div class="small text-success mt-2 kpi-subtitle">+8.4% this month</div>
                    <div class="kpi-chart d-none mt-2" style="height:220px">
                        <canvas id="totalRevenueChart"></canvas>
                    </div>
                    <div class="kpi-text d-none mt-2" style="white-space: pre-wrap"></div>
                    <div class="chart-empty alert alert-secondary small d-none mt-2"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" id="totalOrdersCard">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
