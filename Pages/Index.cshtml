                <select id="kpiMeasure" class="form-select chart-measure"></select>
            </div>
            <div class="col-12 chart-only">
                <label class="form-label" for="kpiDimension">Group by</label>
                <select id="kpiDimension" class="form-select chart-dimension"></select>
            </div>

            <div class="col-12 col-md-4 kpi-query-config">
                <label class="form-label" for="kpiDateField">Date range on</label>
                <select id="kpiDateField" class="form-select chart-date-field"></select>
            </div>
            <div class="col-6 col-md-4 kpi-query-config">
                <label class="form-label" for="kpiDateFrom">From</label>
                <input type="date" id="kpiDateFrom" class="form-control chart-date-from">
