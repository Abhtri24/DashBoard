@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="container-fluid px-0 dashboard-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h4 mb-1" id="dashboardTitle">Dashboard</h2>
            <p class="text-secondary mb-0" id="dashboardDescription">Loading dashboard...</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <label class="visually-hidden" for="demoUserSelect">Demo user</label>
            <select id="demoUserSelect" class="form-select" style="width:auto" aria-label="Demo user"></select>

            <label class="visually-hidden" for="dashboardSelect">Dashboard</label>
            <select id="dashboardSelect" class="form-select" style="min-width:210px" aria-label="Select dashboard">
                <option value="SALES_MAIN">Sales Dashboard</option>
            </select>

            <label class="visually-hidden" for="departmentSelect">Department</label>
            <select id="departmentSelect" class="form-select" style="width:auto" aria-label="Department">
                <option value="sales">Sales</option>
                <option value="finance">Finance</option>
                <option value="hr">HR</option>
                <option value="operations">Operations</option>
            </select>

            <button id="refreshDataButton" class="btn btn-outline-secondary" type="button">Refresh data</button>
            <button id="discardLayoutButton" class="btn btn-outline-secondary" type="button" disabled>Discard</button>
            <button id="saveLayoutButton" class="btn btn-success" type="button" disabled>Save layout</button>
            <button id="editLayoutButton" class="btn btn-outline-secondary" type="button">Edit layout</button>
            <button id="addCardButton" class="btn btn-primary" type="button">
                <span aria-hidden="true">＋</span> Add card
            </button>
        </div>
    </div>

    <div id="dashboardNotice" class="alert alert-info d-none" role="status"></div>
    <div id="dashboardError" class="alert alert-danger d-none" role="alert"></div>
    <div id="dashboardLoading" class="text-secondary py-4">Loading dashboard...</div>
    <div id="dashboardWidgets" class="dashboard-grid d-none"></div>
</div>

<div class="modal fade" id="widgetModal" tabindex="-1" aria-labelledby="widgetModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="widgetForm">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="widgetModalTitle">Add dashboard card</h5>
                        <div class="small text-secondary">
                            Configure a widget using the selected department's dataset.
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="editingWidgetKey" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="widgetTitleInput" class="form-label">Card title</label>
                            <input id="widgetTitleInput" class="form-control" maxlength="100" required placeholder="e.g. Revenue by Region" />
                        </div>

                        <div class="col-md-4">
                            <label for="widgetTypeSelect" class="form-label">Visualization</label>
                            <select id="widgetTypeSelect" class="form-select">
                                <option value="KPI">KPI</option>
                                <option value="BAR">Bar chart</option>
                                <option value="LINE">Line chart</option>
                                <option value="PIE">Pie chart</option>
                                <option value="TABLE">Table</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label for="datasetSelect" class="form-label">Dataset</label>
                            <select id="datasetSelect" class="form-select"></select>
                        </div>

                        <div class="col-md-4" id="dimensionField">
                            <label for="dimensionSelect" class="form-label" id="dimensionLabel">
                                Dimensions
                            </label>                            <select id="dimensionSelect" class="form-select"></select>
                        </div>

                        <div class="col-md-4">
                            <label for="measureSelect" class="form-label" id="measureLabel">
                                Measures
                            </label>
                            <select id="measureSelect" class="form-select"></select>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <h6 class="mb-0">Filters</h6>
                            <small class="text-secondary">
                                Optional conditions applied when the card is loaded.
                            </small>
                        </div>
                        <button id="addWidgetFilter" type="button" class="btn btn-sm btn-outline-primary">
                            Add filter
                        </button>
                    </div>

                    <div id="widgetFilters" class="d-flex flex-column gap-2"></div>

                    <div id="widgetModalError" class="alert alert-danger d-none mt-3 mb-0" role="alert"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="applyWidgetButton">Add to dashboard</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="drilldownModal" tabindex="-1"
     aria-labelledby="drilldownModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="drilldownModalTitle">
                        Underlying records
                    </h5>
                    <div class="small text-secondary" id="drilldownDescription"></div>
                </div>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="drilldownLoading" class="text-secondary d-none">
                    Loading records...
                </div>

                <div id="drilldownError" class="alert alert-danger d-none"></div>

                <div id="drilldownTableContainer" class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead id="drilldownTableHead"></thead>
                        <tbody id="drilldownTableBody"></tbody>
                    </table>
                </div>

                <div id="drilldownEmpty" class="text-secondary d-none">
                    No underlying records found.
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <span class="small text-secondary" id="drilldownPageInfo"></span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary"
                            id="drilldownPrevious" disabled>
                        Previous
                    </button>
                    <button type="button" class="btn btn-outline-primary"
                            id="drilldownNext" disabled>
                        Next
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1rem;
        align-items: stretch;
    }

    .dashboard-widget {
        min-width: 0;
        min-height: 180px;
    }

        .dashboard-widget .card {
            height: 100%;
            border: 0;
            box-shadow: 0 .125rem .5rem rgba(0,0,0,.07);
        }

        .dashboard-widget .card-body {
            min-width: 0;
        }

        .dashboard-widget .chart-container {
            position: relative;
            height: 280px;
        }

        .dashboard-widget canvas {
            max-width: 100%;
        }

    .widget-kpi-value {
        font-size: clamp(1.5rem, 2.4vw, 2.25rem);
        font-weight: 600;
        overflow-wrap: anywhere;
        line-height: 1.2;
    }

    .widget-table-container {
        overflow-x: auto;
    }

    .widget-actions {
        opacity: .65;
    }

    .dashboard-widget:hover .widget-actions,
    .dashboard-edit-mode .widget-actions {
        opacity: 1;
    }

    .dashboard-edit-mode .dashboard-widget {
        outline: 1px dashed #9ca3af;
        outline-offset: 3px;
    }

    .widget-drag-handle {
        cursor: grab;
        user-select: none;
    }

    .widget-dragging {
        opacity: .45;
    }

    @@media(max-width:768px) {
        .dashboard-widget {
            grid-column: span 12 !important;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script type="module" src="~/js/dashboard.js" asp-append-version="true"></script>
}