@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
      href="~/css/dashboard.css"
      asp-append-version="true" />

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 mb-1" id="dashboardTitle">Dashboard</h2>
            <p class="text-secondary mb-0" id="dashboardDescription">
                Loading dashboard...
            </p>
        </div>
    </div>

    <div id="dashboardError"
         class="alert alert-danger d-none"
         role="alert"></div>

    <div id="dashboardLoading" class="text-secondary py-4">
        Loading dashboard...
    </div>

    <div id="dashboardWidgets"
         class="dashboard-grid d-none">
    </div>
</div>

<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1rem;
        align-items: stretch;
    }

    .dashboard-widget {
        min-width: 0;
    }

    .dashboard-widget .card {
        height: 100%;
        border: 0;
        box-shadow: 0 .125rem .5rem rgba(0, 0, 0, .07);
    }

    .dashboard-widget .chart-container {
        position: relative;
        height: 280px;
    }

    .dashboard-widget canvas {
        max-width: 100%;
    }

    .widget-kpi-value {
        font-size: 2rem;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .widget-table-container {
        overflow-x: auto;
    }

    @@media (max-width: 768px) {
        .dashboard-widget {
            grid-column: span 12 !important;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (() => {
            const dashboardKey = "SALES_MAIN";

            // Prototype preview value only.
            // Do not use this value as an authorization mechanism.
            const department = "sales";

            const dashboardUrl =
                `/api/dash/dashboard/${encodeURIComponent(dashboardKey)}` +
                `?department=${encodeURIComponent(department)}`;

            const widgetDataUrl = widgetKey =>
                `/api/dash/dashboard/${encodeURIComponent(dashboardKey)}` +
                `/widget/${encodeURIComponent(widgetKey)}` +
                `?department=${encodeURIComponent(department)}` +
                `&page=1&pageSize=100`;

            const container = document.getElementById("dashboardWidgets");
            const loading = document.getElementById("dashboardLoading");
            const errorElement = document.getElementById("dashboardError");

            const chartInstances = [];

            function showError(message) {
                errorElement.textContent = message;
                errorElement.classList.remove("d-none");
            }

            function createElement(tag, className, text) {
                const element = document.createElement(tag);

                if (className) {
                    element.className = className;
                }

                if (text !== undefined && text !== null) {
                    element.textContent = text;
                }

                return element;
            }

            async function getJson(url, options = {}) {
                const response = await fetch(url, {
                    headers: {
                        "Accept": "application/json",
                        ...(options.headers || {})
                    },
                    ...options
                });

                if (!response.ok) {
                    const body = await response.json().catch(() => null);
                    throw new Error(
                        body?.error ||
                        body?.message ||
                        `Request failed (${response.status}).`
                    );
                }

                return response.json();
            }

            function getColumnKey(item) {
                return item?.columnKey || item?.ColumnKey || "";
            }

            function getLabel(item) {
                return item?.labelOverride ||
                    item?.LabelOverride ||
                    getColumnKey(item);
            }

            function getRows(result) {
                return result?.rows || result?.Rows || [];
            }

            function getFirstMeasure(widget) {
                return widget.measures?.[0] ||
                    widget.Measures?.[0] ||
                    null;
            }

            function getFirstDimension(widget) {
                return widget.dimensions?.[0] ||
                    widget.Dimensions?.[0] ||
                    null;
            }

            function getValue(row, key) {
                if (!row || !key) return undefined;

                // SQL aliases may differ in casing.
                const actualKey = Object.keys(row).find(
                    candidate => candidate.toLowerCase() === key.toLowerCase()
                );

                return actualKey ? row[actualKey] : undefined;
            }

            function formatValue(value) {
                if (value === null || value === undefined) return "—";

                if (typeof value === "number") {
                    return new Intl.NumberFormat().format(value);
                }

                return String(value);
            }

            function createWidgetShell(widget) {
                const widgetElement = createElement(
                    "section",
                    "dashboard-widget"
                );

                const columnSpan =
                    Number(widget.gridColumnSpan ?? widget.GridColumnSpan ?? 12);

                const rowSpan =
                    Number(widget.gridRowSpan ?? widget.GridRowSpan ?? 1);

                widgetElement.style.gridColumn =
                    `span ${Math.min(12, Math.max(1, columnSpan))}`;

                widgetElement.style.gridRow =
                    `span ${Math.max(1, rowSpan)}`;

                const card = createElement("div", "card");
                const body = createElement("div", "card-body");

                const title = createElement(
                    "h3",
                    "h6 mb-3",
                    widget.title || widget.Title || "Untitled widget"
                );

                body.appendChild(title);
                card.appendChild(body);
                widgetElement.appendChild(card);

                return { widgetElement, body };
            }

            function renderKpi(body, widget, rows) {
                const measure = getFirstMeasure(widget);
                const key = getColumnKey(measure);

                const value = rows.length
                    ? getValue(rows[0], key)
                    : null;

                const valueElement = createElement(
                    "div",
                    "widget-kpi-value",
                    formatValue(value)
                );

                body.appendChild(valueElement);
            }

            function renderTable(body, rows) {
                if (!rows.length) {
                    body.appendChild(
                        createElement("p", "text-secondary mb-0", "No data available.")
                    );
                    return;
                }

                const columns = Object.keys(rows[0]);

                const wrapper = createElement("div", "widget-table-container");
                const table = createElement("table", "table table-sm table-hover mb-0");
                const thead = document.createElement("thead");
                const headerRow = document.createElement("tr");

                columns.forEach(column => {
                    headerRow.appendChild(
                        createElement("th", "", column)
                    );
                });

                thead.appendChild(headerRow);
                table.appendChild(thead);

                const tbody = document.createElement("tbody");

                rows.forEach(row => {
                    const tr = document.createElement("tr");

                    columns.forEach(column => {
                        tr.appendChild(
                            createElement("td", "", formatValue(row[column]))
                        );
                    });

                    tbody.appendChild(tr);
                });

                table.appendChild(tbody);
                wrapper.appendChild(table);
                body.appendChild(wrapper);
            }

            function renderChart(body, widget, rows, type) {
                const measure = getFirstMeasure(widget);
                const dimension = getFirstDimension(widget);

                const measureKey = getColumnKey(measure);
                const dimensionKey = getColumnKey(dimension);

                if (!measureKey || !dimensionKey) {
                    body.appendChild(
                        createElement(
                            "p",
                            "text-secondary mb-0",
                            "This chart needs one measure and one dimension."
                        )
                    );
                    return;
                }

                if (!rows.length) {
                    body.appendChild(
                        createElement("p", "text-secondary mb-0", "No data available.")
                    );
                    return;
                }

                const chartContainer = createElement("div", "chart-container");
                const canvas = document.createElement("canvas");

                chartContainer.appendChild(canvas);
                body.appendChild(chartContainer);

                const labels = rows.map(row =>
                    formatValue(getValue(row, dimensionKey))
                );

                const values = rows.map(row =>
                    Number(getValue(row, measureKey) ?? 0)
                );

                const chartType = type.toLowerCase() === "pie"
                    ? "pie"
                    : type.toLowerCase();

                const chart = new Chart(canvas, {
                    type: chartType,
                    data: {
                        labels,
                        datasets: [{
                            label: getLabel(measure),
                            data: values,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: chartType === "pie"
                            }
                        },
                        scales: chartType === "pie"
                            ? {}
                            : {
                                y: {
                                    beginAtZero: true
                                }
                            }
                    }
                });

                chartInstances.push(chart);
            }

            async function renderWidget(widget) {
                const { widgetElement, body } = createWidgetShell(widget);

                container.appendChild(widgetElement);

                try {
                    const widgetKey = widget.widgetKey || widget.WidgetKey;

                    const result = await getJson(widgetDataUrl(widgetKey), {
                        method: "POST"
                    });

                    const rows = getRows(result);
                    const type = (
                        widget.widgetType ||
                        widget.WidgetType ||
                        ""
                    ).toUpperCase();

                    switch (type) {
                        case "KPI":
                            renderKpi(body, widget, rows);
                            break;

                        case "TABLE":
                            renderTable(body, rows);
                            break;

                        case "BAR":
                        case "LINE":
                        case "PIE":
                            renderChart(body, widget, rows, type);
                            break;

                        default:
                            body.appendChild(
                                createElement(
                                    "p",
                                    "text-secondary mb-0",
                                    `Unsupported widget type: ${type || "unknown"}`
                                )
                            );
                    }
                } catch (error) {
                    body.appendChild(
                        createElement(
                            "div",
                            "alert alert-danger small mb-0",
                            error.message
                        )
                    );
                }
            }

            async function loadDashboard() {
                try {
                    const dashboard = await getJson(dashboardUrl);

                    document.getElementById("dashboardTitle").textContent =
                        dashboard.displayName ||
                        dashboard.DisplayName ||
                        "Dashboard";

                    document.getElementById("dashboardDescription").textContent =
                        dashboard.description ||
                        dashboard.Description ||
                        "";

                    const widgets = dashboard.widgets || dashboard.Widgets || [];

                    loading.classList.add("d-none");
                    container.classList.remove("d-none");

                    if (!widgets.length) {
                        container.appendChild(
                            createElement(
                                "p",
                                "text-secondary",
                                "No widgets are configured for this dashboard."
                            )
                        );
                        return;
                    }

                    // Preserve the order supplied by the configuration service.
                    for (const widget of widgets) {
                        await renderWidget(widget);
                    }
                } catch (error) {
                    loading.classList.add("d-none");
                    showError(error.message);
                }
            }

            loadDashboard();
        })();
    </script>
}
