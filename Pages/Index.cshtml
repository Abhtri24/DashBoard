        function initializeDashboardGrid() {
            const grid = document.createElement('div');
            grid.id = 'dashboardGrid';
            grid.className = 'dashboard-grid';

            const overviewRow = document.querySelector('.row.g-3.mb-4');
            const chartRows = [...document.querySelectorAll('.row.g-3.mb-4')];
            const chartRow = chartRows[1];

            for (const row of [overviewRow, chartRow]) {
                if (!row) continue;
                for (const item of [...row.children]) {
                    const cardRoot = item.querySelector('[id$="Card"]');
                    if (!cardRoot) continue;
                    const cardId = cardRoot.id.replace(/Card$/, '');
                    const card = cards[cardId];
                    if (!card) continue;
                    item.classList.remove('col-12', 'col-sm-6', 'col-xl-3', 'col-xl-8', 'col-xl-4');
                    item.classList.add('dashboard-grid-item', `span-${card.width || 3}`);
                    grid.appendChild(item);
                }
                row.remove();
            }

            const editor = document.getElementById('kpiSharedEditor');
            editor.parentNode.insertBefore(grid, editor);
            // Keep the shared editor as its own full-width panel, never inside a KPI card.
            grid.after(editor);
            for (const card of Object.values(cards)) addDeleteControl(card);
            refreshDashboardLayout();
        }


function refreshDashboardLayout() {
    const grid = document.getElementById('dashboardGrid');
    if (!grid) return;

    const items = [...grid.querySelectorAll(':scope > .dashboard-grid-item')];

    const cardItems = items.map(item => {
        const root = item.querySelector('[id$="Card"]');
        const id = root?.id.replace(/Card$/, '');
        return { item, card: cards[id] };
    }).filter(entry => entry.card);

    // Separate compact cards from charts.
    const compactItems = cardItems.filter(({ card }) =>
        card.isKpi && card.contentType !== 'chart'
    );

    const chartItems = cardItems.filter(({ card }) =>
        !card.isKpi || card.contentType === 'chart'
    );

    const compactCount = compactItems.length;
    const chartCount = chartItems.length;

    // Determine unused space after the compact cards.
    const compactColumns = (compactCount % 4) * 3;
    const remainingColumns = compactColumns === 0
        ? 12
        : 12 - compactColumns;

    // Assign compact cards their normal width.
    for (const { item } of compactItems) {
        item.classList.remove(
            'span-3', 'span-4', 'span-6', 'span-8', 'span-12'
        );
        item.classList.add('span-3');
        item.classList.remove('is-chart-card');
    }

    // If charts can use the remaining space beside compact cards,
    // let the first chart occupy that space.
    if (chartCount > 0 && compactCount % 4 !== 0 &&
        remainingColumns >= 6) {

        chartItems.forEach(({ item }, index) => {
            item.classList.remove(
                'span-3', 'span-4', 'span-6', 'span-8', 'span-12'
            );

            item.classList.add(index === 0
                ? `span-${remainingColumns}`
                : 'span-12');

            item.classList.add('is-chart-card');
        });

        return;
    }

    // Otherwise, place charts in pairs.
    chartItems.forEach(({ item }, index) => {
        item.classList.remove(
            'span-3', 'span-4', 'span-6', 'span-8', 'span-12'
        );

        const isLastOddChart =
            chartCount % 2 === 1 && index === chartCount - 1;

        item.classList.add(isLastOddChart ? 'span-12' : 'span-6');
        item.classList.add('is-chart-card');
    });
}


        function addDeleteControl(card) {
            const root = document.getElementById(`${card.id}Card`);
            if (!root || root.querySelector('.dashboard-card-delete')) return;
            const header = root.querySelector('.card-body > .d-flex');
            if (!header) return;

            const actions = document.createElement('div');
            actions.className = 'dashboard-card-actions d-flex align-items-center gap-2 flex-shrink-0';
            const editButton = header.querySelector('.edit-chart');
            if (editButton) actions.appendChild(editButton);

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn btn-outline-danger btn-sm dashboard-card-delete';
            removeButton.setAttribute('aria-label', `Delete ${card.title}`);
            removeButton.title = 'Delete card';
            removeButton.innerHTML = '&times;';
            removeButton.addEventListener('click', () => deleteCard(card.id));
            actions.appendChild(removeButton);
            header.appendChild(actions);
        }

        function createDashboardCardMarkup(card) {
            const wrapper = document.createElement('div');
            wrapper.className = `dashboard-grid-item span-${card.width || 3}`;
            wrapper.innerHTML = `
                <section class="card border-0 shadow-sm" id="${card.id}Card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div class="text-secondary small" id="${card.id}Title"></div>
                            <button type="button" class="btn btn-outline-secondary btn-sm edit-chart" data-card="${card.id}" aria-expanded="false">Edit</button>
                        </div>
                        <div class="fs-3 fw-semibold mt-2 kpi-value">Configure metric</div>
                        <div class="small text-secondary mt-2 kpi-subtitle"></div>
                        <div class="kpi-chart d-none mt-2 dashboard-kpi-chart"><canvas id="${card.id}Chart"></canvas></div>
                        <div class="kpi-text d-none mt-2" style="white-space: pre-wrap"></div>
                        <div class="chart-empty alert alert-secondary small d-none mt-2"></div>
                    </div>
                </section>`;
            return wrapper;
        }

        async function addCard() {
            const id = `custom${++customCardSequence}`;
            const card = {
                id, width: 3, isKpi: true, dataset: 'sales', contentType: 'kpi',
                title: 'New card', measureKey: '', dimensionKey: 'yearMonth',
                chartType: 'bar', filters: [], dateField: 'orderDate',
                dateFrom: '', dateTo: '', text: '', chart: null
            };
            cards[id] = card;
            const wrapper = createDashboardCardMarkup(card);
            document.getElementById('dashboardGrid').appendChild(wrapper);
            document.getElementById(`${id}Title`).textContent = card.title;
            addDeleteControl(card);
            wrapper.querySelector('.edit-chart').addEventListener('click', () => editCard(card));
            await editCard(card);
        }

        function deleteCard(cardId) {
            const card = cards[cardId];
            if (!card) return;
            if (card.chart) card.chart.destroy();
            if (activeKpiCard === card) closeEditor(card);
            document.getElementById(`${cardId}Card`)?.closest('.dashboard-grid-item')?.remove();
            delete cards[cardId];
            refreshDashboardLayout();
        }

        let customCardSequence = 0;

        function cardElement(card, selector) {
            const cardControl = document.querySelector(`#${card.id}Card ${selector}`);
            if (cardControl) return cardControl;

            return card.isKpi
                ? document.querySelector(`#kpiSharedEditor ${selector}`)
                : null;
        }

        function getMetadata() {
            if (!metadataPromise) {
                metadataPromise = fetch('/api/dash/meta/datasets?dataset=sales')
                    .then(async response => {
                        const metadata = await response.json();
                        if (!response.ok) throw new Error(metadata.error || 'Could not load dataset metadata.');
                        return metadata;
                    })
                    .catch(error => {
                        metadataPromise = null;
                        throw error;
                    });
            }
            return metadataPromise;
        }

        function addOneDay(isoDate) {
            const date = new Date(isoDate + 'T00:00:00Z');
            date.setUTCDate(date.getUTCDate() + 1);
            return date.toISOString().slice(0, 10);
        }

        function getDimension(metadata, key) {
            return (metadata.dimensions || []).find(item => item.key === key);
        }

        function getMeasure(metadata, key) {
            return (metadata.measures || []).find(item => item.key === key);
        }

        function populateSelect(select, items, selectedKey, emptyLabel) {
            select.replaceChildren();
            if (emptyLabel) select.add(new Option(emptyLabel, ''));
            for (const item of items) select.add(new Option(item.label, item.key));
            if ([...select.options].some(option => option.value === selectedKey)) {
                select.value = selectedKey;
            } else if (select.options.length) {
                select.selectedIndex = emptyLabel ? 0 : 0;
            }
        }

        function setupEditor(card, metadata) {
            const dimensions = metadata.dimensions || [];
            const measures = metadata.measures || [];
            const dimensionSelect = cardElement(card, '.chart-dimension');
            const measureSelect = cardElement(card, '.chart-measure');
            const dateSelect = cardElement(card, '.chart-date-field');
            const dateDimensions = dimensions.filter(d =>
                ['date', 'datetime'].includes((d.type || '').toLowerCase()));

            if (card.isKpi && !card.measureKey) {
                const preferredPattern = {
                    totalOrders: /order|count/i,
                    averageOrderValue: /average|avg/i,
                    activeRegions: /region/i
                }[card.id];

                const preferredMeasure = preferredPattern
                    ? measures.find(m => preferredPattern.test(m.label) || preferredPattern.test(m.key))
                    : null;

                card.measureKey = preferredMeasure?.key || measures[0]?.key || '';
            }

            populateSelect(dimensionSelect, dimensions, card.dimensionKey);
            populateSelect(measureSelect, measures, card.measureKey);
            populateSelect(dateSelect, dateDimensions, card.dateField, '(No date range)');

            cardElement(card, '.chart-date-from').value = card.dateFrom || '';
            cardElement(card, '.chart-date-to').value = card.dateTo || '';
            cardElement(card, '.chart-type').value = card.chartType || 'bar';

            const filtersContainer = cardElement(card, '.chart-filters');
            filtersContainer.replaceChildren();
            for (const filter of (card.filters || [])) {
                addFilterRow(card, metadata, filter);
            }

            cardElement(card, '.chart-editor-error').classList.add('d-none');

            if (card.isKpi) {
                document.getElementById('kpiContentType').value = card.contentType || 'kpi';
                document.getElementById('kpiTitle').value = card.title || '';
                document.getElementById('kpiTextContent').value = card.text || '';
                updateKpiEditorFields();
            }
        }

        function updateKpiEditorFields() {
            const type = document.getElementById('kpiContentType').value;

            document.querySelectorAll('#kpiSharedEditor .kpi-query-config')
                .forEach(element => element.classList.toggle('d-none', type === 'text'));

            document.querySelectorAll('#kpiSharedEditor .chart-only')
                .forEach(element => element.classList.toggle('d-none', type !== 'chart'));

            document.querySelectorAll('#kpiSharedEditor .text-only')
                .forEach(element => element.classList.toggle('d-none', type !== 'text'));
        }

        function addFilterRow(card, metadata, initial = null) {
            const dimensions = metadata.dimensions || [];
            if (!dimensions.length) return;

            const row = document.createElement('div');
            row.className = 'row g-2 align-items-center chart-filter-row';

            const field = document.createElement('select');
            field.className = 'form-select filter-field';
            for (const dimension of dimensions) field.add(new Option(dimension.label, dimension.key));

            const operator = document.createElement('select');
            operator.className = 'form-select filter-operator';

            const value = document.createElement('input');
            value.className = 'form-control filter-value';
            value.placeholder = 'Value';
            value.required = true;

            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'btn btn-outline-secondary w-100';
            remove.textContent = 'Remove';
            remove.addEventListener('click', () => row.remove());

            function updateOperators() {
                const dimension = getDimension(metadata, field.value);
                const type = (dimension?.type || 'string').toLowerCase();
                const operators = ['eq', 'neq'];
                if (['number', 'numeric', 'integer', 'decimal', 'date', 'datetime'].includes(type)) {
                    operators.push('gt', 'gte', 'lt', 'lte');
                }
                const labels = {
                    eq: 'Equals', neq: 'Does not equal', gt: 'Greater than',
                    gte: 'At least', lt: 'Less than', lte: 'At most'
                };
                operator.replaceChildren();
                for (const op of operators) operator.add(new Option(labels[op], op));

                value.type = type === 'date' ? 'date' :
                    ['number', 'numeric', 'integer', 'decimal'].includes(type) ? 'number' : 'text';
                if (value.type === 'number') value.step = 'any';
                else value.removeAttribute('step');

                if (initial && initial.dimension === field.value &&
                    operators.includes(initial.operator)) {
                    operator.value = initial.operator;
                }
            }

            field.addEventListener('change', updateOperators);

            const fieldCol = document.createElement('div');
            fieldCol.className = 'col-12 col-md-4';
            fieldCol.append(field);
            const operatorCol = document.createElement('div');
            operatorCol.className = 'col-7 col-md-3';
            operatorCol.append(operator);
            const valueCol = document.createElement('div');
            valueCol.className = 'col-5 col-md-3';
            valueCol.append(value);
            const removeCol = document.createElement('div');
            removeCol.className = 'col-12 col-md-2';
            removeCol.append(remove);

            row.append(fieldCol, operatorCol, valueCol, removeCol);
            cardElement(card, '.chart-filters').append(row);

            if (initial && dimensions.some(d => d.key === initial.dimension)) {
                field.value = initial.dimension;
            }
            updateOperators();
            if (initial) {
                operator.value = initial.operator;
                value.value = initial.value ?? '';
            }
        }

function openEditor(card) {
    const editor = card.isKpi
        ? document.getElementById('kpiSharedEditor')
        : document.getElementById(`${card.id}Editor`);

    if (card.isKpi) {
        bootstrap.Modal.getOrCreateInstance(editor).show();
    } else {
        editor.classList.remove('d-none');
    }

    cardElement(card, '.edit-chart')
        .setAttribute('aria-expanded', 'true');
}

function closeEditor(card) {
    if (!card) return;

    const editor = card.isKpi
        ? document.getElementById('kpiSharedEditor')
        : document.getElementById(`${card.id}Editor`);

    if (card.isKpi) {
        bootstrap.Modal.getOrCreateInstance(editor).hide();
    } else {
        editor.classList.add('d-none');
    }

    cardElement(card, '.edit-chart')
        .setAttribute('aria-expanded', 'false');

    if (card.isKpi && activeKpiCard === card) {
        activeKpiCard = null;
    }
}

async function editCard(card) {
    if (!card) return;

    const button = cardElement(card, '.edit-chart');
    button.disabled = true;

   if (card.isKpi) {
    activeKpiCard = card;

    const editor = document.getElementById('kpiSharedEditor');
    editor.dataset.card = card.id;

        editor.querySelectorAll('.cancel-chart, .add-chart-filter')
            .forEach(control => control.dataset.card = card.id);

        openEditor(card);
    }

    try {
        const metadata = await getMetadata();
        setupEditor(card, metadata);
        openEditor(card);
    } catch (error) {
        if (card.isKpi) {
            const editor = document.getElementById('kpiSharedEditor');
            const errorBox = editor.querySelector('.chart-editor-error');
            errorBox.textContent = error.message;
            errorBox.classList.remove('d-none');
        } else {
            showCardError(card, error.message);
        }
    } finally {
        button.disabled = false;
    }
}

        function showCardError(card, message) {
            const error = cardElement(card, '.chart-editor-error');
            error.textContent = message;
            error.classList.remove('d-none');
        }

        function collectDraft(card, metadata) {
            const dimensionKey = cardElement(card, '.chart-dimension').value;
            const measureKey = cardElement(card, '.chart-measure').value;
            if (!dimensionKey || !measureKey) {
                throw new Error('Choose both a dimension and a measure.');
            }
            if (!getDimension(metadata, dimensionKey) || !getMeasure(metadata, measureKey)) {
                throw new Error('The selected dimension or measure is not available in the dataset.');
            }

            const customFilters = [];
            for (const row of cardElement(card, '.chart-filters').querySelectorAll('.chart-filter-row')) {
                const value = row.querySelector('.filter-value').value.trim();
                if (!value) throw new Error('Enter a value for every filter or remove the empty filter.');
                customFilters.push({
                    dimension: row.querySelector('.filter-field').value,
                    operator: row.querySelector('.filter-operator').value,
                    value
                });
            }

            const dateField = cardElement(card, '.chart-date-field').value;
            const dateFrom = cardElement(card, '.chart-date-from').value;
            const dateTo = cardElement(card, '.chart-date-to').value;
            if (dateFrom && dateTo && dateFrom > dateTo) {
                throw new Error('"From" date must be on or before "To" date.');
            }

            return {
                dimensionKey,
                measureKey,
                chartType: cardElement(card, '.chart-type').value,
                dateField,
                dateFrom,
                dateTo,
                filters: customFilters
            };
        }

        function buildQueryFilters(card, draft) {
            const filters = [];
            for (const row of cardElement(card, '.chart-filters').querySelectorAll('.chart-filter-row')) {
                filters.push({
                    dimension: row.querySelector('.filter-field').value,
                    operator: row.querySelector('.filter-operator').value,
                    value: row.querySelector('.filter-value').value.trim()
                });
            }
            if (draft.dateField && draft.dateFrom) {
                filters.push({ dimension: draft.dateField, operator: 'gte', value: draft.dateFrom });
            }
            if (draft.dateField && draft.dateTo) {
                filters.push({ dimension: draft.dateField, operator: 'lt', value: addOneDay(draft.dateTo) });
            }
            return filters;
        }

        function formatMeasure(value, measure) {
            if ((measure?.format || '').toLowerCase().includes('inr') ||
                (measure?.format || '').toLowerCase().includes('currency')) {
                return money(value);
            }
            return number(value);
        }

        function renderChart(card, labels, values, measure, chartType) {
            const canvas = document.getElementById(`${card.id}Chart`);
            const isCircular = chartType === 'pie' || chartType === 'doughnut';
            const colors = labels.map((_, index) => pieColors[index % pieColors.length]);
            const dataset = {
                label: measure.label,
                data: values,
                backgroundColor: isCircular ? colors : '#0d6efd',
                borderColor: chartType === 'line' ? '#0d6efd' : undefined,
                fill: chartType === 'line',
                tension: chartType === 'line' ? 0.3 : undefined,
                borderWidth: isCircular ? 0 : 1
            };

            if (card.chart) card.chart.destroy();

            card.chart = new Chart(canvas, {
                type: chartType,
                data: { labels, datasets: [dataset] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    onClick: async (_event, elements) => {
                        if (!elements.length) return;
                        const index = elements[0].index;
                        const selectedValue = labels[index];
                        await loadDrilldown(card, selectedValue);
                    },
                    plugins: {
                        legend: { display: isCircular, position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: context => `${context.label}: ${formatMeasure(context.raw, measure)}`
                            }
                        }
                    },
                    scales: isCircular ? {} : {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: value => formatMeasure(value, measure) }
                        }
                    }
                }
            });

            canvas.style.cursor = 'pointer';
            const emptyMessage = cardElement(card, '.chart-empty');
            if (labels.length) {
                emptyMessage.classList.add('d-none');
            } else {
                emptyMessage.textContent = 'No results matched this configuration.';
                emptyMessage.classList.remove('d-none');
            }
        }

        function setKpiContentVisible(card, type) {
            const root = document.getElementById(`${card.id}Card`);

            root.querySelector('.kpi-value').classList.toggle('d-none', type !== 'kpi');
            root.querySelector('.kpi-chart').classList.toggle('d-none', type !== 'chart');
            root.querySelector('.kpi-text').classList.toggle('d-none', type !== 'text');
            root.querySelector('.kpi-subtitle').classList.toggle('d-none', type === 'text');

            const emptyMessage = root.querySelector('.chart-empty');
            if (type !== 'chart') emptyMessage.classList.add('d-none');

            if (type !== 'chart' && card.chart) {
                card.chart.destroy();
                card.chart = null;
            }
        }

        function renderKpiMetric(card, value, measure) {
            const root = document.getElementById(`${card.id}Card`);

            document.getElementById(`${card.id}Title`).textContent = card.title;
            root.querySelector('.kpi-value').textContent = formatMeasure(value, measure);
            root.querySelector('.kpi-subtitle').textContent = measure.label;

            setKpiContentVisible(card, 'kpi');
        }

        function renderKpiText(card) {
            const root = document.getElementById(`${card.id}Card`);

            document.getElementById(`${card.id}Title`).textContent = card.title;
            root.querySelector('.kpi-text').textContent = card.text;

            setKpiContentVisible(card, 'text');
        }

        function renderKpiChart(card, labels, values, measure, dimension, chartType) {
            const root = document.getElementById(`${card.id}Card`);

            document.getElementById(`${card.id}Title`).textContent = card.title;
            root.querySelector('.kpi-subtitle').textContent =
                `${measure.label} grouped by ${dimension.label}`;

            // Make the canvas visible before Chart.js measures its dimensions.
            setKpiContentVisible(card, 'chart');
            renderChart(card, labels, values, measure, chartType);
        }

        function getAppliedFilters(card) {
            const filters = (card.filters || []).map(filter => ({ ...filter }));
            if (card.dateField && card.dateFrom) {
                filters.push({ dimension: card.dateField, operator: 'gte', value: card.dateFrom });
            }
            if (card.dateField && card.dateTo) {
                filters.push({ dimension: card.dateField, operator: 'lt', value: addOneDay(card.dateTo) });
            }
            return filters;
        }

        function setDrilldownStatus(message, isError = false) {
            const status = document.getElementById('drilldownStatus');
            status.textContent = message;
            status.classList.toggle('text-danger', isError);
            status.classList.toggle('text-secondary', !isError);
        }

        function formatCellValue(value) {
            if (value === null || value === undefined) return '';
            if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}T/.test(value)) {
                const date = new Date(value);
                if (!Number.isNaN(date.getTime())) return date.toLocaleString('en-IN');
            }
            if (typeof value === 'number') return number(value);
            return String(value);
        }

        function renderDrilldownTable() {
    if (!currentDrilldownData) return;

    const { columns, rows } = currentDrilldownData;
    const head = document.getElementById('drilldownHead');
    const body = document.getElementById('drilldownBody');

    head.replaceChildren();
    body.replaceChildren();

    const visibleColumns = columns.filter(column =>
        visibleDrilldownColumnKeys.has(column.key)
    );

    for (const column of visibleColumns) {
        const th = document.createElement('th');
        th.textContent = column.label;
        th.title = column.label;
        th.scope = 'col';
        head.appendChild(th);
    }

    for (const row of rows) {
        const tr = document.createElement('tr');

        for (const column of visibleColumns) {
            const td = document.createElement('td');
            const value = formatCellValue(row[column.key]);

            td.textContent = value;
            td.title = value;
            tr.appendChild(td);
        }

        body.appendChild(tr);
    }
}

function setupDrilldownColumns(columns) {
    const picker = document.getElementById('drilldownColumnPicker');
    const options = document.getElementById('drilldownColumnOptions');

    options.replaceChildren();
  visibleDrilldownColumnKeys = new Set(
    columns.slice(0, 7).map(column => column.key)
);

    for (const column of columns) {
        const label = document.createElement('label');
        label.className = 'form-check d-flex align-items-center gap-2';

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'form-check-input mt-0';
        checkbox.checked = visibleDrilldownColumnKeys.has(column.key);

        checkbox.addEventListener('change', () => {
            if (checkbox.checked) {
                visibleDrilldownColumnKeys.add(column.key);
            } else {
                // Keep at least one column visible.
                if (visibleDrilldownColumnKeys.size === 1) {
                    checkbox.checked = true;
                    return;
                }

                visibleDrilldownColumnKeys.delete(column.key);
            }

            renderDrilldownTable();
        });

        const text = document.createElement('span');
        text.textContent = column.label;

        label.append(checkbox, text);
        options.appendChild(label);
    }

    picker.classList.remove('d-none');
}

        async function loadDrilldown(card, selectedValue) {
            const section = document.getElementById('drilldownSection');
            const wrap = document.getElementById('drilldownTableWrap');
            const title = document.getElementById('drilldownTitle');
            const subtitle = document.getElementById('drilldownSubtitle');

            // Invalidate any previous request.
            drilldownRequestId++;

            // Start a fresh drilldown and a fresh page cache.
            currentDrilldownState = {
                dataset: card.dataset,
                dimension: card.dimensionKey,
                value: selectedValue === '(blank)' ? null : selectedValue,
                displayValue: selectedValue,
                filters: getAppliedFilters(card),
                cardId: card.id,
                page: 1,
                pages: new Map(),
                loading: false
            };

            currentDrilldownData = null;

            title.textContent = 'Loading selected records…';
            subtitle.textContent = `${card.dimensionKey} = ${selectedValue} · from ${card.title || card.id}`;

            wrap.classList.add('d-none');

            document.getElementById('drilldownColumnPicker')
                .classList.add('d-none');

            document.getElementById('drilldownPagination')
                .classList.add('d-none');

            document.getElementById('drilldownHead').replaceChildren();
            document.getElementById('drilldownBody').replaceChildren();

            setDrilldownStatus('Fetching matching records…');

            section.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

            await loadDrilldownPage(1);
        }


        async function loadDrilldownPage(page) {
            const state = currentDrilldownState;

            if (!state || state.loading) return;

            // Check whether this page has already been fetched.
            const cachedPage = state.pages.get(page);

            if (cachedPage) {
                state.page = page;
                currentDrilldownData = cachedPage;

                renderDrilldownTable();
                updateDrilldownPagination();

                document.getElementById('drilldownTableWrap')
                    .classList.remove('d-none');

                setDrilldownStatus(
                    getDrilldownPageStatus(cachedPage, page)
                );

                return;
            }

            state.loading = true;

            const requestId = ++drilldownRequestId;

            updateDrilldownPagination();

            setDrilldownStatus(`Loading page ${page}…`);

            try {
                const response = await fetch('/api/dash/drilldown', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        dataset: state.dataset,
                        dimension: state.dimension,
                        value: state.value,
                        filters: state.filters,
                        page: page
                    })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(
                        data.error || 'Could not load selected records.'
                    );
                }

                // Ignore a response belonging to an older chart selection.
                if (
                    requestId !== drilldownRequestId ||
                    state !== currentDrilldownState
                ) {
                    return;
                }

                if (!data.columns?.length || !data.rows?.length) {
                    currentDrilldownData = null;

                    document.getElementById('drilldownColumnPicker')
                        .classList.add('d-none');

                    document.getElementById('drilldownTableWrap')
                        .classList.add('d-none');

                    document.getElementById('drilldownPagination')
                        .classList.add('d-none');

                    setDrilldownStatus(
                        'No underlying records matched this chart selection.'
                    );

                    return;
                }

                // Store this page in the browser cache.
                state.pages.set(page, data);
                state.page = page;

                currentDrilldownData = data;

                // Columns are common to every page.
                if (page === 1) {
                    setupDrilldownColumns(data.columns);
                }

                renderDrilldownTable();

                document.getElementById('drilldownTableWrap')
                    .classList.remove('d-none');

                updateDrilldownPagination();

                setDrilldownStatus(
                    getDrilldownPageStatus(data, page)
                );

                document.getElementById('drilldownTitle')
                    .textContent = 'Selected data';

                document.getElementById('drilldownSubtitle')
                    .textContent =
                    `${state.dimension} = ${state.displayValue} · from ${
                        cards[state.cardId]?.title || state.cardId
                    }`;
            }
            catch (error) {
                if (
                    requestId === drilldownRequestId &&
                    state === currentDrilldownState
                ) {
                    setDrilldownStatus(error.message, true);
                }
            }
            finally {
                if (state === currentDrilldownState) {
                    state.loading = false;
                    updateDrilldownPagination();
                }
            }
        }


        function getDrilldownPageStatus(data, page) {
            const start = (page - 1) * 50 + 1;
            const end = start + data.rows.length - 1;

            return `Showing ${start}–${end} records · Page ${page}${
                data.hasMore ? ' · more records available' : ''
            }.`;
        }


        function updateDrilldownPagination() {
            const pagination =
                document.getElementById('drilldownPagination');

            const previous =
                document.getElementById('drilldownPrevious');

            const next =
                document.getElementById('drilldownNext');

            const pageInfo =
                document.getElementById('drilldownPageInfo');

            const state = currentDrilldownState;

            if (!state || !currentDrilldownData) {
                pagination.classList.add('d-none');
                return;
            }

            pagination.classList.remove('d-none');

            previous.disabled =
                state.loading || state.page === 1;

            next.disabled =
                state.loading || !currentDrilldownData.hasMore;

            pageInfo.textContent = `Page ${state.page}`;
        }


        async function changeDrilldownPage(direction) {
            const state = currentDrilldownState;

            if (!state || state.loading || !currentDrilldownData) {
                return;
            }

            const nextPage = state.page + direction;

            if (nextPage < 1) return;

            if (direction > 0 && !currentDrilldownData.hasMore) {
                return;
            }

            await loadDrilldownPage(nextPage);
        }


        async function applyKpiCard(card) {
            const button = document.getElementById('applyKpiCard');
            const error = cardElement(card, '.chart-editor-error');
            const originalText = button.textContent;

            error.classList.add('d-none');
            button.disabled = true;
            button.textContent = 'Loading...';

            try {
                const metadata = await getMetadata();
                const contentType = document.getElementById('kpiContentType').value;
                const title = document.getElementById('kpiTitle').value.trim();

                if (!title) throw new Error('Enter a card title.');

                if (contentType === 'text') {
                    const text = document.getElementById('kpiTextContent').value;
                    if (!text.trim()) throw new Error('Enter the text to display.');

                    card.contentType = 'text';
                    card.title = title;
                    card.text = text;

                    renderKpiText(card);
                    closeEditor(card);
                    return;
                }

                const measureKey = cardElement(card, '.chart-measure').value;
                const measure = getMeasure(metadata, measureKey);
                if (!measure) throw new Error('Choose a valid measure.');

                const dimensionKey = cardElement(card, '.chart-dimension').value;
                const chartType = cardElement(card, '.chart-type').value;
                const dateField = cardElement(card, '.chart-date-field').value;
                const dateFrom = cardElement(card, '.chart-date-from').value;
                const dateTo = cardElement(card, '.chart-date-to').value;

                let dimension = null;
                if (contentType === 'chart') {
                    dimension = getDimension(metadata, dimensionKey);
                    if (!dimension) throw new Error('Choose a valid group-by dimension.');
                }

                if (dateFrom && dateTo && dateFrom > dateTo) {
                    throw new Error('"From" date must be on or before "To" date.');
                }

                const customFilters = [];
                for (const row of cardElement(card, '.chart-filters')
                    .querySelectorAll('.chart-filter-row')) {
                    const value = row.querySelector('.filter-value').value.trim();
                    if (!value) {
                        throw new Error('Enter a value for every filter or remove the empty filter.');
                    }

                    customFilters.push({
                        dimension: row.querySelector('.filter-field').value,
                        operator: row.querySelector('.filter-operator').value,
                        value
                    });
                }

                const draft = { dateField, dateFrom, dateTo };
                const filters = buildQueryFilters(card, draft);

                const response = await fetch('/api/dash/query', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        dataset: card.dataset,
                        dimensions: contentType === 'chart' ? [dimensionKey] : [],
                        measures: [measureKey],
                        filters,
                        sort: contentType === 'chart'
                            ? [{ field: measureKey, direction: 'desc' }]
                            : [],
                        page: 1,
                        pageSize: contentType === 'chart' ? 200 : 1
                    })
                });

                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.error || 'The card query failed.');
                }

                if (!Array.isArray(data) || data.length === 0) {
                    throw new Error('No data matched this configuration.');
                }

                // Commit the configuration only after the query succeeds.
                Object.assign(card, {
                    contentType,
                    title,
                    measureKey,
                    dimensionKey,
                    chartType,
                    filters: customFilters,
                    dateField,
                    dateFrom,
                    dateTo
                });

                if (contentType === 'kpi') {
                    renderKpiMetric(card, data[0][measureKey], measure);
                } else {
                    const labels = data.map(row => row[dimensionKey] == null
                        ? '(blank)' : String(row[dimensionKey]));
                    const values = data.map(row => Number(row[measureKey]) || 0);

                    renderKpiChart(card, labels, values, measure, dimension, chartType);
                }

                refreshDashboardLayout();
                closeEditor(card);
            } catch (error) {
                showCardError(card, error.message);
            } finally {
                button.disabled = false;
                button.textContent = originalText;
            }
        }

        async function applyCard(card) {
            const button = cardElement(card, '.apply-chart');
            const error = cardElement(card, '.chart-editor-error');
            error.classList.add('d-none');
            button.disabled = true;
            const originalText = button.textContent;
            button.textContent = 'Loading...';

            try {
                const metadata = await getMetadata();
                const draft = collectDraft(card, metadata);
                const filters = buildQueryFilters(card, draft);

                const response = await fetch('/api/dash/query', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        dataset: card.dataset,
                        dimensions: [draft.dimensionKey],
                        measures: [draft.measureKey],
                        filters,
                        sort: [{ field: draft.measureKey, direction: 'desc' }],
                        page: 1,
                        pageSize: 200
                    })
                });

                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'The chart query failed.');

                const dimension = getDimension(metadata, draft.dimensionKey);
                const measure = getMeasure(metadata, draft.measureKey);
                const labels = data.map(row => row[draft.dimensionKey] == null
                    ? '(blank)' : String(row[draft.dimensionKey]));
                const values = data.map(row => Number(row[draft.measureKey]) || 0);

                card.dimensionKey = draft.dimensionKey;
                card.measureKey = draft.measureKey;
                card.chartType = draft.chartType;
                card.filters = draft.filters;
                card.dateField = draft.dateField;
                card.dateFrom = draft.dateFrom;
                card.dateTo = draft.dateTo;

                card.title = `${measure.label} by ${dimension.label}`;
                document.getElementById(`${card.id}Title`).textContent = card.title;
                document.getElementById(`${card.id}Subtitle`).textContent =
                    `${data.length} grouped result${data.length === 1 ? '' : 's'}`;

                renderChart(card, labels, values, measure, draft.chartType);
                closeEditor(card);
            } catch (error) {
                showCardError(card, error.message);
            } finally {
                button.disabled = false;
                button.textContent = originalText;
            }
        }

        async function loadOverview() {
            try {
                const response = await fetch('/api/dash/overview');
                if (!response.ok) throw new Error(`Overview request failed: ${response.status}`);
                const data = await response.json();

                document.getElementById('totalRevenue').textContent = money(data.kpis.totalRevenue);
                document.getElementById('totalOrders').textContent = number(data.kpis.totalOrders);
                document.getElementById('averageOrderValue').textContent = money(data.kpis.averageOrderValue);
                document.getElementById('activeRegions').textContent = number(data.kpis.activeRegions);

                const revenue = cards.revenue;
                const regions = cards.region;
                renderChart(revenue,
                    data.monthlyRevenue.map(row => String(row.Month)),
                    data.monthlyRevenue.map(row => Number(row.Revenue)),
                    { label: 'Revenue', format: 'inr' }, 'line');
                renderChart(regions,
                    data.regionalRevenue.map(row => String(row.Region)),
                    data.regionalRevenue.map(row => Number(row.Revenue)),
                    { label: 'Revenue', format: 'inr' }, 'doughnut');


            } catch (error) {
                const box = document.getElementById('overviewError');
                box.textContent = 'Could not load the dashboard overview: ' + error.message;
                box.classList.remove('d-none');
                console.error('Failed to load dashboard overview:', error);
            }
        }

        initializeDashboardGrid();

        document.getElementById('kpiSharedEditor')
            .addEventListener('hidden.bs.modal', () => {
                if (activeKpiCard) {
                    cardElement(activeKpiCard, '.edit-chart')
                        ?.setAttribute('aria-expanded', 'false');
                    activeKpiCard = null;
                }
            });

        document.getElementById('addDashboardCard')
            .addEventListener('click', addCard);

        document.querySelectorAll('.edit-chart').forEach(button => {
            button.addEventListener('click', () => editCard(cards[button.dataset.card]));
        });

        document.querySelectorAll('.cancel-chart').forEach(button => {
            button.addEventListener('click', () => {
                const isSharedEditor = button.closest('#kpiSharedEditor');
                const card = isSharedEditor
                    ? activeKpiCard
                    : cards[button.dataset.card];

                if (card) closeEditor(card);
            });
        });

        document.querySelectorAll('.add-chart-filter').forEach(button => {
            button.addEventListener('click', async () => {
                const isSharedEditor = button.closest('#kpiSharedEditor');
                const card = isSharedEditor
                    ? activeKpiCard
                    : cards[button.dataset.card];

                if (!card) return;

                try {
                    const metadata = await getMetadata();
                    addFilterRow(card, metadata);
                } catch (error) {
                    showCardError(card, error.message);
                }
            });
        });

        document.querySelectorAll('.apply-chart').forEach(button => {
            button.addEventListener('click', () => applyCard(cards[button.dataset.card]));
        });

        document.getElementById('kpiContentType')
            .addEventListener('change', updateKpiEditorFields);

        document.getElementById('applyKpiCard')
            .addEventListener('click', () => {
                if (activeKpiCard) applyKpiCard(activeKpiCard);
            });

        document.getElementById('drilldownPrevious')
            .addEventListener('click', () => {
                changeDrilldownPage(-1);
            });

        document.getElementById('drilldownNext')
            .addEventListener('click', () => {
                changeDrilldownPage(1);
            });

        loadOverview();
    </script>
}
