     aria-labelledby="kpiEditorTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="kpiEditorTitle">Configure card</h5>
                <button type="button" class="btn-close cancel-chart"
