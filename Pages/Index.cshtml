                            <div class="text-secondary small" id="totalOrdersTitle">Total Orders</div>
                            <div class="fs-3 fw-semibold mt-2 kpi-value" id="totalOrders">Loading...</div>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm edit-chart"
