
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DashBoard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DashBoard.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
    <div class="d-flex min-vh-100">
        <aside class="bg-white border-end p-3 flex-shrink-0"
               style="width: 240px;">
            <a class="navbar-brand fw-bold d-block mb-4"
               asp-page="/Index">DashBoard</a>

            <div class="text-secondary small text-uppercase mb-2">
                Workspace
            </div>

            <nav class="nav nav-pills flex-column gap-1">
                <a class="nav-link active" asp-page="/Index">
                    Overview
                </a>
                <a class="nav-link text-dark" asp-page="/QueryBuilder">
                    Query Builder
                </a>
                <a class="nav-link text-dark" asp-page="/DataSources">
                    Data Sources
                </a>
            </nav>
        </aside>

        <div class="flex-grow-1 min-w-0">
            <header class="bg-white border-bottom px-4 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0">@ViewData["Title"]</h1>
                    <span class="text-secondary small">
                        Analytics Workspace
                    </span>
                </div>
            </header>

            <main class="p-3 p-md-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
